DEEPSEEK_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
# Only enable when the legacy variable actually contains a DeepSeek key.
DEEPSEEK_USE_DASHSCOPE_ALIAS=false
OPENCODE_API_KEY=
AUTOCLIP_SOURCE_DIR=videos/雍正王朝
# Production uses Go with OPENCODE_API_KEY; official DeepSeek is an explicit alternative only.
# Additional reviewer is disabled by default.

# Optional official Azure Speech backend; never reuse a model-provider key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
